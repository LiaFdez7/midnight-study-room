{
  "id": "./",
  "name": "Midnight Study Room",
  "short_name": "Study Room",
  "description": "Lia's enchanted study room: focus timer, course bookshelf, and a daily notebook connected to the Morning Brief.",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "orientation": "landscape",
  "background_color": "#10142A",
  "theme_color": "#1C2346",
  "categories": ["education", "productivity"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Open my notebook", "short_name": "Notebook", "url": "./?open=notebook", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Start a focus block", "short_name": "Focus", "url": "./?focus=start", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Study log", "short_name": "Study log", "url": "./?open=log", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
